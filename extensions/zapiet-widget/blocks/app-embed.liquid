<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script>
  (function() {
    function setupCalendarPortal() {
      var PORTAL_ID = 'zapiet-cal-portal';
      if (document.getElementById(PORTAL_ID)) return;

      var portal = document.createElement('div');
      portal.id = PORTAL_ID;
      portal.style.cssText =
        'position:fixed;top:0;left:0;width:0;height:0;overflow:visible;' +
        'background:transparent;border:none;padding:0;margin:0;pointer-events:none;';
      document.body.appendChild(portal);

      if (typeof portal.showPopover === 'function') {
        portal.setAttribute('popover', 'manual');
        portal.showPopover();
      }

      var calObs = new MutationObserver(function(mutations) {
        for (var i = 0; i < mutations.length; i++) {
          var added = mutations[i].addedNodes;
          for (var j = 0; j < added.length; j++) {
            var node = added[j];
            if (
              node.nodeType === 1 &&
              node.classList &&
              node.classList.contains('flatpickr-calendar') &&
              !portal.contains(node) &&
              !node.closest('dialog')
            ) {
              portal.appendChild(node);
            }
          }
        }
      });
      calObs.observe(document.body, { childList: true, subtree: true });
    }

    function loadWidget() {
      var widgetScript = document.createElement('script');
      widgetScript.src = "{{ 'widget.js' | asset_url }}";
      document.body.appendChild(widgetScript);
    }

    var flatpickrScript = document.createElement('script');
    flatpickrScript.src = 'https://cdn.jsdelivr.net/npm/flatpickr';
    flatpickrScript.onload = function() {
      setupCalendarPortal();
      loadWidget();
    };
    flatpickrScript.onerror = function() {
      setupCalendarPortal();
      loadWidget();
    };
    document.head.appendChild(flatpickrScript);
  })();
</script>

