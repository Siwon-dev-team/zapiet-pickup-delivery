{% schema %}
{
  "name": "Pickup & Delivery",
  "target": "section",
  "stylesheet": "widget.css",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Pickup & Delivery Options" }
  ]
}
{% endschema %}

<div class="zapiet-container" id="zapiet-widget-root" 
     data-shop="{{ shop.permanent_domain }}"
     data-cart-total="{{ cart.total_price | divided_by: 100.0 }}"
     data-cart-weight="{{ cart.total_weight | divided_by: 1000.0 }}">
  <h3>{{ block.settings.title }}</h3>
  <div class="zapiet-loading">Loading options...</div>
  
  <div class="zapiet-content" style="display:none;">
    <div class="zapiet-tabs" id="zapiet-tabs"></div>
    
    <div class="zapiet-error" id="zapiet-error" style="display:none;"></div>
    

    <div class="zapiet-panel" id="panel-pickup" style="display:none;">
      <p class="zapiet-instruction">Please select a pickup location:</p>
      
      <div id="zapiet-location-list" class="zapiet-location-list"></div>
      
      <div id="zapiet-pickup-datetime" style="display:none; margin-top: 20px;">
        <div class="zapiet-datetime">
          <div class="zapiet-field">
            <label class="zapiet-label">
              <svg class="zapiet-icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
              </svg>
              Pickup Date:
            </label>
            <input type="date" id="zapiet-pickup-date" class="zapiet-input" required />
          </div>
          <div class="zapiet-field">
            <label class="zapiet-label">
              <svg class="zapiet-icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              Pickup Time:
            </label>
            <select id="zapiet-pickup-time" class="zapiet-select" required>
              <option value="">Select time...</option>
            </select>
          </div>
        </div>
        
        <div id="zapiet-pickup-note-container" style="display:none; margin-top: 15px;">
          <label class="zapiet-label">Pickup Note (optional):</label>
          <textarea id="zapiet-pickup-note" class="zapiet-input" rows="3" placeholder="Any special instructions..."></textarea>
        </div>
      </div>
      
      <div id="zapiet-pickup-rate" class="zapiet-rate-display" style="display:none;"></div>
    </div>


    <div class="zapiet-panel" id="panel-delivery" style="display:none;">
      <label class="zapiet-label">
        Enter your postal code (first 3 digits) to check if you are eligible for local delivery:
      </label>
      
      <div style="display: flex; gap: 10px; align-items: flex-start;">
        <input type="text" id="zapiet-postal-code" class="zapiet-input" placeholder="e.g., V5R" style="margin-bottom: 0; flex: 1;" maxlength="7" />
        <button type="button" id="zapiet-check-delivery" class="zapiet-button" style="flex-shrink: 0;">
          <svg class="zapiet-icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
      
      <div id="zapiet-delivery-result" class="zapiet-delivery-result"></div>
      
      <div id="zapiet-delivery-available" style="display:none;">
        <div class="zapiet-datetime" style="margin-top: 20px;">
          <div class="zapiet-field">
            <label class="zapiet-label">
              <svg class="zapiet-icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
              </svg>
              Delivery Date:
            </label>
            <input type="date" id="zapiet-delivery-date" class="zapiet-input" required />
          </div>
          <div class="zapiet-field">
            <label class="zapiet-label">
              <svg class="zapiet-icon-inline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              Delivery Time:
            </label>
            <select id="zapiet-delivery-time" class="zapiet-select" required>
              <option value="">Select time...</option>
              <option value="9:00 AM - 12:00 PM">9:00 AM - 12:00 PM</option>
              <option value="12:00 PM - 3:00 PM">12:00 PM - 3:00 PM</option>
              <option value="3:00 PM - 6:00 PM">3:00 PM - 6:00 PM</option>
              <option value="5:00 PM - 11:00 PM">5:00 PM - 11:00 PM</option>
            </select>
          </div>
        </div>
        
        <div id="zapiet-delivery-note-container" style="display:none; margin-top: 15px;">
          <label class="zapiet-label">Delivery Note (optional):</label>
          <textarea id="zapiet-delivery-note" class="zapiet-input" rows="3" placeholder="Special delivery instructions..."></textarea>
        </div>
        
        <div id="zapiet-delivery-rate" class="zapiet-rate-display" style="display:none; margin-top: 15px;"></div>
      </div>
    </div>
  </div>
  

  <input type="hidden" name="attributes[Method]" id="attr-method" value="" />
  <input type="hidden" name="attributes[Pickup Location]" id="attr-location" value="" />
  <input type="hidden" name="attributes[Pickup Date]" id="attr-date" value="" />
  <input type="hidden" name="attributes[Pickup Time]" id="attr-time" value="" />
  <input type="hidden" name="attributes[Pickup Note]" id="attr-pickup-note" value="" />
  <input type="hidden" name="attributes[Delivery Address]" id="attr-delivery-address" value="" />
  <input type="hidden" name="attributes[Postal Code]" id="attr-postal-code" value="" />
  <input type="hidden" name="attributes[Delivery Note]" id="attr-delivery-note" value="" />
</div>

<style>
  .zapiet-container { 
    padding: 20px; 
    border: 1px solid #e1e1e1; 
    border-radius: 8px;
    margin: 20px 0; 
    background: #fff;
  }
  .zapiet-container h3 {
    margin: 0 0 15px 0;
    font-size: 18px;
    font-weight: 600;
  }
  .zapiet-tabs { 
    display: flex; 
    margin-bottom: 20px; 
    border-bottom: 2px solid #e1e1e1;
    gap: 5px;
  }
  .zapiet-tab { 
    flex: 1; 
    padding: 12px; 
    cursor: pointer; 
    background: none; 
    border: none; 
    font-weight: 600;
    font-size: 14px;
    color: #6b7280;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }
  .zapiet-tab:hover {
    color: #000;
  }
  .zapiet-tab.active { 
    color: var(--zapiet-primary-color, #008060);
    border-bottom-color: var(--zapiet-primary-color, #008060);
  }
  .zapiet-label {
    display: block;
    font-weight: 500;
    margin-bottom: 8px;
    color: #374151;
  }
  .zapiet-input, .zapiet-select { 
    width: 100%; 
    padding: 10px 12px; 
    margin-bottom: 15px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 14px;
    transition: border-color 0.2s;
  }
  .zapiet-input:focus, .zapiet-select:focus {
    outline: none;
    border-color: var(--zapiet-primary-color, #008060);
    box-shadow: 0 0 0 2px rgba(0, 128, 96, 0.1);
  }
  .zapiet-button {
    background: var(--zapiet-primary-color, #008060);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }
  .zapiet-button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .zapiet-store-info {
    display: flex;
    align-items: start;
    gap: 10px;
    padding: 12px;
    background: #f9fafb;
    border-radius: 6px;
    margin-bottom: 15px;
  }
  .zapiet-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--zapiet-primary-color, #008060);
  }
  .zapiet-store-info p {
    margin: 0;
    font-size: 14px;
    color: #374151;
  }
  .zapiet-datetime {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }
  .zapiet-field {
    display: flex;
    flex-direction: column;
  }
  .zapiet-error {
    padding: 12px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 6px;
    color: #991b1b;
    margin-bottom: 15px;
    font-size: 14px;
  }
  .zapiet-loading {
    text-align: center;
    padding: 20px;
    color: #6b7280;
  }
  .zapiet-instruction {
    font-weight: 500;
    margin-bottom: 15px;
    color: #374151;
    font-size: 15px;
  }
  .zapiet-location-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .zapiet-location-item {
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    padding: 14px;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
  }
  .zapiet-location-item:hover {
    border-color: var(--zapiet-primary-color, #008060);
    background: #f9fafb;
  }
  .zapiet-location-item.selected {
    border-color: var(--zapiet-primary-color, #008060);
    background: #ecfdf5;
  }
  .zapiet-location-radio {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }
  .zapiet-location-radio:checked + .zapiet-location-content .zapiet-radio-indicator {
    background: var(--zapiet-primary-color, #008060);
    border-color: var(--zapiet-primary-color, #008060);
  }
  .zapiet-location-radio:checked + .zapiet-location-content .zapiet-radio-indicator:after {
    display: block;
  }
  .zapiet-location-content {
    display: flex;
    align-items: start;
    gap: 12px;
  }
  .zapiet-radio-indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #d1d5db;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    margin-top: 2px;
    transition: all 0.2s;
  }
  .zapiet-radio-indicator:after {
    content: '';
    position: absolute;
    display: none;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: white;
  }
  .zapiet-location-info {
    flex: 1;
  }
  .zapiet-location-title {
    font-weight: 600;
    color: #111827;
    margin-bottom: 4px;
    font-size: 15px;
  }
  .zapiet-location-address {
    font-size: 13px;
    color: #6b7280;
    margin-bottom: 6px;
  }
  .zapiet-location-link {
    color: var(--zapiet-primary-color, #008060);
    font-size: 13px;
    text-decoration: underline;
    cursor: pointer;
  }
  .zapiet-location-link:hover {
    text-decoration: none;
  }
  .zapiet-delivery-result {
    margin-top: 15px;
  }
  .zapiet-success-msg {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px;
    background: #ecfdf5;
    border: 1px solid #10b981;
    border-radius: 6px;
    color: #065f46;
    font-size: 14px;
    font-weight: 500;
  }
  .zapiet-error-msg {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 6px;
    color: #991b1b;
    font-size: 14px;
  }
  .zapiet-rate-display {
    padding: 12px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    font-size: 14px;
  }
  .zapiet-rate-display strong {
    color: var(--zapiet-primary-color, #008060);
    font-size: 16px;
  }
  .zapiet-icon-inline {
    width: 16px;
    height: 16px;
    display: inline-block;
    vertical-align: middle;
    margin-right: 4px;
    color: var(--zapiet-primary-color, #008060);
  }

  #zapiet-delivery-available .zapiet-datetime {
    display: none;
  }

  #zapiet-delivery-available .zapiet-field {
    display: none;
  }

  #zapiet-delivery-note-container {
    display: none !important;
  }

  #zapiet-delivery-rate {
    display: none !important;
  }
</style>

<script src="{{ 'widget.js' | asset_url }}" defer></script>
