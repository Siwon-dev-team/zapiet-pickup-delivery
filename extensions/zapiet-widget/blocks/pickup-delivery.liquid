{% schema %}
{
  "name": "Pickup & Delivery Widget",
  "target": "section",
  "stylesheet": "widget.css",
  "javascript": "widget.js",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Pickup & Delivery Options" }
  ]
}
{% endschema %}

<div class="zapiet-container" id="zapiet-widget-root" data-shop="{{ shop.permanent_domain }}">
  <h3>{{ block.settings.title }}</h3>
  <div class="zapiet-loading">Loading options...</div>
  
  <div class="zapiet-content" style="display:none;">
    <div class="zapiet-tabs" id="zapiet-tabs">
      <!-- Tabs will be generated by JS based on settings -->
    </div>
    
    <div class="zapiet-error" id="zapiet-error" style="display:none;"></div>
    
    <!-- Pickup Panel -->
    <div class="zapiet-panel" id="panel-pickup" style="display:none;">
      <label class="zapiet-label">Choose a location:</label>
      <select id="zapiet-location-select" class="zapiet-select">
        <option value="">Select a store...</option>
      </select>
      
      <div id="zapiet-pickup-details" style="display:none; margin-top: 15px;">
        <div class="zapiet-store-info">
          <svg class="zapiet-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          <p id="zapiet-store-address"></p>
        </div>
        
        <div class="zapiet-datetime">
          <div class="zapiet-field">
            <label class="zapiet-label">Pickup Date:</label>
            <input type="date" id="zapiet-pickup-date" class="zapiet-input" required />
          </div>
          <div class="zapiet-field">
            <label class="zapiet-label">Pickup Time:</label>
            <input type="time" id="zapiet-pickup-time" class="zapiet-input" required />
          </div>
        </div>
        
        <div id="zapiet-pickup-note-container" style="display:none; margin-top: 15px;">
          <label class="zapiet-label">Pickup Note (optional):</label>
          <textarea id="zapiet-pickup-note" class="zapiet-input" rows="3" placeholder="Any special instructions..."></textarea>
        </div>
      </div>
    </div>

    <!-- Delivery Panel -->
    <div class="zapiet-panel" id="panel-delivery" style="display:none;">
      <label class="zapiet-label">Delivery Address:</label>
      <input type="text" id="zapiet-delivery-address" class="zapiet-input" placeholder="Street Address" />
      
      <label class="zapiet-label">Postal Code:</label>
      <input type="text" id="zapiet-postal-code" class="zapiet-input" placeholder="Enter postal code" />
      <button type="button" id="zapiet-check-delivery" class="zapiet-button">Check Availability</button>
      
      <div id="zapiet-delivery-result"></div>
      
      <div class="zapiet-datetime" style="display:none;" id="zapiet-delivery-datetime">
        <div class="zapiet-field">
          <label class="zapiet-label">Delivery Date:</label>
          <input type="date" id="zapiet-delivery-date" class="zapiet-input" />
        </div>
        <div class="zapiet-field">
          <label class="zapiet-label">Delivery Time:</label>
          <input type="time" id="zapiet-delivery-time" class="zapiet-input" />
        </div>
      </div>
      
      <div id="zapiet-delivery-note-container" style="display:none; margin-top: 15px;">
        <label class="zapiet-label">Delivery Note (optional):</label>
        <textarea id="zapiet-delivery-note" class="zapiet-input" rows="3" placeholder="Special delivery instructions..."></textarea>
      </div>
    </div>
  </div>
  
  <!-- Hidden form attributes -->
  <input type="hidden" name="attributes[Method]" id="attr-method" value="" />
  <input type="hidden" name="attributes[Pickup Location]" id="attr-location" value="" />
  <input type="hidden" name="attributes[Pickup Date]" id="attr-date" value="" />
  <input type="hidden" name="attributes[Pickup Time]" id="attr-time" value="" />
  <input type="hidden" name="attributes[Pickup Note]" id="attr-pickup-note" value="" />
  <input type="hidden" name="attributes[Delivery Address]" id="attr-delivery-address" value="" />
  <input type="hidden" name="attributes[Postal Code]" id="attr-postal-code" value="" />
  <input type="hidden" name="attributes[Delivery Note]" id="attr-delivery-note" value="" />
</div>

<style>
  .zapiet-container { 
    padding: 20px; 
    border: 1px solid #e1e1e1; 
    border-radius: 8px;
    margin: 20px 0; 
    background: #fff;
  }
  .zapiet-container h3 {
    margin: 0 0 15px 0;
    font-size: 18px;
    font-weight: 600;
  }
  .zapiet-tabs { 
    display: flex; 
    margin-bottom: 20px; 
    border-bottom: 2px solid #e1e1e1;
    gap: 5px;
  }
  .zapiet-tab { 
    flex: 1; 
    padding: 12px; 
    cursor: pointer; 
    background: none; 
    border: none; 
    font-weight: 600;
    font-size: 14px;
    color: #6b7280;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }
  .zapiet-tab:hover {
    color: #000;
  }
  .zapiet-tab.active { 
    color: var(--zapiet-primary-color, #008060);
    border-bottom-color: var(--zapiet-primary-color, #008060);
  }
  .zapiet-label {
    display: block;
    font-weight: 500;
    margin-bottom: 8px;
    color: #374151;
  }
  .zapiet-input, .zapiet-select { 
    width: 100%; 
    padding: 10px 12px; 
    margin-bottom: 15px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 14px;
    transition: border-color 0.2s;
  }
  .zapiet-input:focus, .zapiet-select:focus {
    outline: none;
    border-color: var(--zapiet-primary-color, #008060);
    box-shadow: 0 0 0 2px rgba(0, 128, 96, 0.1);
  }
  .zapiet-button {
    background: var(--zapiet-primary-color, #008060);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
  }
  .zapiet-button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .zapiet-store-info {
    display: flex;
    align-items: start;
    gap: 10px;
    padding: 12px;
    background: #f9fafb;
    border-radius: 6px;
    margin-bottom: 15px;
  }
  .zapiet-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--zapiet-primary-color, #008060);
  }
  .zapiet-store-info p {
    margin: 0;
    font-size: 14px;
    color: #374151;
  }
  .zapiet-datetime {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }
  .zapiet-field {
    display: flex;
    flex-direction: column;
  }
  .zapiet-error {
    padding: 12px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 6px;
    color: #991b1b;
    margin-bottom: 15px;
    font-size: 14px;
  }
  .zapiet-loading {
    text-align: center;
    padding: 20px;
    color: #6b7280;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const root = document.getElementById('zapiet-widget-root');
  if(!root) return;

  const shop = root.getAttribute('data-shop');
  const content = root.querySelector('.zapiet-content');
  const loading = root.querySelector('.zapiet-loading');
  const errorDiv = document.getElementById('zapiet-error');
  
  // Get cart data (Shopify Liquid provides this)
  const cartTotal = {{ cart.total_price | divided_by: 100.0 }};
  const cartWeight = {{ cart.total_weight | divided_by: 1000.0 }}; // Convert grams to kg
  
  // Fetch widget data from app
  fetch(`/apps/zapiet?shop=${shop}`)
    .then(res => res.json())
    .then(data => {
      loading.style.display = 'none';
      content.style.display = 'block';
      
      // Apply primary color
      if (data.settings?.primaryColor) {
        root.style.setProperty('--zapiet-primary-color', data.settings.primaryColor);
      }
      
      initWidget(data);
    })
    .catch(err => {
      console.error("Zapiet Widget Error:", err);
      loading.textContent = "Unable to load options.";
    });

  function checkActivationConditions(conditions) {
    if (!conditions || conditions === '{}') return { valid: true };
    
    try {
      const rules = JSON.parse(conditions);
      
      // Check minimum order value
      if (rules.minOrderValue && cartTotal < rules.minOrderValue) {
        return { 
          valid: false, 
          message: `Minimum order value is $${rules.minOrderValue}. Current: $${cartTotal.toFixed(2)}` 
        };
      }
      
      // Check maximum order value
      if (rules.maxOrderValue && cartTotal > rules.maxOrderValue) {
        return { 
          valid: false, 
          message: `Maximum order value is $${rules.maxOrderValue}` 
        };
      }
      
      // Check minimum weight
      if (rules.minWeight && cartWeight < rules.minWeight) {
        return { 
          valid: false, 
          message: `Minimum weight is ${rules.minWeight}kg. Current: ${cartWeight.toFixed(2)}kg` 
        };
      }
      
      // Check maximum weight
      if (rules.maxWeight && cartWeight > rules.maxWeight) {
        return { 
          valid: false, 
          message: `Maximum weight is ${rules.maxWeight}kg. Current: ${cartWeight.toFixed(2)}kg` 
        };
      }
      
      return { valid: true };
    } catch (e) {
      console.error("Error parsing activation conditions:", e);
      return { valid: true }; // Default to allowing if parse fails
    }
  }

  function initWidget(data) {
    const settings = data.settings || {};
    const locations = data.locations || [];
    const tabsContainer = document.getElementById('zapiet-tabs');
    const methodInput = document.getElementById('attr-method');
    
    // Check activation conditions
    const pickupCheck = checkActivationConditions(settings.pickupActivationConditions);
    const deliveryCheck = checkActivationConditions(settings.deliveryActivationConditions);
    
    // Create tabs based on what's enabled and valid
    if (settings.enablePickup && pickupCheck.valid) {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'zapiet-tab active';
      tab.dataset.tab = 'pickup';
      tab.textContent = settings.pickupTitle || 'Store Pickup';
      tabsContainer.appendChild(tab);
      document.getElementById('panel-pickup').style.display = 'block';
      methodInput.value = 'Pickup';
    }
    
    if (settings.enableDelivery && deliveryCheck.valid) {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'zapiet-tab';
      if (!settings.enablePickup || !pickupCheck.valid) {
        tab.classList.add('active');
        document.getElementById('panel-delivery').style.display = 'block';
        methodInput.value = 'Delivery';
      }
      tab.dataset.tab = 'delivery';
      tab.textContent = settings.deliveryTitle || 'Local Delivery';
      tabsContainer.appendChild(tab);
    }
    
    // Show error if neither option is available
    if ((!settings.enablePickup || !pickupCheck.valid) && (!settings.enableDelivery || !deliveryCheck.valid)) {
      errorDiv.textContent = pickupCheck.message || deliveryCheck.message || 'No shipping options available for your cart.';
      errorDiv.style.display = 'block';
      return;
    }
    
    // Populate pickup locations
    const select = document.getElementById('zapiet-location-select');
    const pickupLocations = locations.filter(l => l.isPickup);
    pickupLocations.forEach(loc => {
      const opt = document.createElement('option');
      opt.value = loc.name;
      opt.dataset.id = loc.id;
      opt.dataset.address = `${loc.address}${loc.city ? ', ' + loc.city : ''}`;
      opt.textContent = loc.name;
      select.appendChild(opt);
    });
    
    // Handle preselect location
    if (settings.preselectLocation === 'first' && pickupLocations.length > 0) {
      select.value = pickupLocations[0].name;
      select.dispatchEvent(new Event('change')); // Trigger change event
    }
    
    // Show/hide note fields based on settings
    if (settings.enablePickupNote) {
      document.getElementById('zapiet-pickup-note-container').style.display = 'block';
    }
    if (settings.enableDeliveryNote) {
      document.getElementById('zapiet-delivery-note-container').style.display = 'block';
    }
    
    // Tab switching
    root.querySelectorAll('.zapiet-tab').forEach(t => {
      t.addEventListener('click', (e) => {
        root.querySelectorAll('.zapiet-tab').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        
        const tab = e.target.dataset.tab;
        document.getElementById('panel-pickup').style.display = tab === 'pickup' ? 'block' : 'none';
        document.getElementById('panel-delivery').style.display = tab === 'delivery' ? 'block' : 'none';
        
        methodInput.value = tab === 'Pickup' ? 'Pickup' : 'Delivery';
      });
    });
    
    // Pickup location change
    select.addEventListener('change', function() {
      const selectedOpt = this.options[this.selectedIndex];
      const details = document.getElementById('zapiet-pickup-details');
      const locInput = document.getElementById('attr-location');
      
      if(this.value) {
        details.style.display = 'block';
        document.getElementById('zapiet-store-address').textContent = selectedOpt.dataset.address;
        locInput.value = this.value;
        
        // Set minimum date to tomorrow
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        document.getElementById('zapiet-pickup-date').min = tomorrow.toISOString().split('T')[0];
      } else {
        details.style.display = 'none';
        locInput.value = "";
      }
    });
    
    // Pickup date/time handlers
    document.getElementById('zapiet-pickup-date').addEventListener('change', function() {
      document.getElementById('attr-date').value = this.value;
    });
    document.getElementById('zapiet-pickup-time').addEventListener('change', function() {
      document.getElementById('attr-time').value = this.value;
    });
    
    // Pickup note handler
    if (settings.enablePickupNote) {
      document.getElementById('zapiet-pickup-note').addEventListener('input', function() {
        document.getElementById('attr-pickup-note').value = this.value;
      });
    }
    
    // Delivery note handler
    if (settings.enableDeliveryNote) {
      document.getElementById('zapiet-delivery-note').addEventListener('input', function() {
        document.getElementById('attr-delivery-note').value = this.value;
      });
    }
    
    // Delivery postal code check
    document.getElementById('zapiet-check-delivery').addEventListener('click', function() {
      const postalCode = document.getElementById('zapiet-postal-code').value.trim();
      const resultDiv = document.getElementById('zapiet-delivery-result');
      
      if (!postalCode) {
        resultDiv.innerHTML = '<p style="color: #991b1b;">Please enter a postal code.</p>';
        return;
      }
      
      // Validate against delivery zones using the postalCodeValidation setting
      const conditions = settings.deliveryActivationConditions || '{}';
      const validationMode = settings.postalCodeValidation || 'none';
      
      try {
        const rules = JSON.parse(conditions);
        if (rules.deliveryZones && rules.deliveryZones.length > 0) {
          let isValid = false;
          const postalCodeUpper = postalCode.toUpperCase();
          
          if (validationMode === 'none') {
            // No validation, allow all
            isValid = true;
          } else if (validationMode === 'partial') {
            // Match first 3 characters
            const prefix = postalCodeUpper.substring(0, 3);
            isValid = rules.deliveryZones.some(zone => prefix.startsWith(zone.toUpperCase()));
          } else if (validationMode === 'full') {
            // Exact match
            isValid = rules.deliveryZones.some(zone => postalCodeUpper === zone.toUpperCase());
          }
          
          if (isValid) {
            resultDiv.innerHTML = '<p style="color: #059669;">✓ Delivery available to your area!</p>';
            document.getElementById('zapiet-delivery-datetime').style.display = 'grid';
            document.getElementById('attr-postal-code').value = postalCode;
          } else {
            resultDiv.innerHTML = '<p style="color: #991b1b;">✗ Sorry, delivery not available to your postal code.</p>';
            document.getElementById('zapiet-delivery-datetime').style.display = 'none';
          }
        } else {
          // No zones configured, assume all valid
          resultDiv.innerHTML = '<p style="color: #059669;">✓ Delivery available!</p>';
          document.getElementById('zapiet-delivery-datetime').style.display = 'grid';
          document.getElementById('attr-postal-code').value = postalCode;
        }
      } catch (e) {
        resultDiv.innerHTML = '<p style="color: #059669;">✓ Delivery available!</p>';
        document.getElementById('zapiet-delivery-datetime').style.display = 'grid';
        document.getElementById('attr-postal-code').value = postalCode;
      }
    });
    
    // Delivery address handler
    document.getElementById('zapiet-delivery-address').addEventListener('change', function() {
      document.getElementById('attr-delivery-address').value = this.value;
    });
  }
});
</script>
