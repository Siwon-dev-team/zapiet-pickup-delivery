generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Location {
  id                           String   @id @default(uuid())
  shop                         String
  name                         String
  address                      String
  city                         String?
  zip                          String?
  country                      String?
  isPickup                     Boolean  @default(false)
  isDelivery                   Boolean  @default(false)
  businessHours                String   @default("{}")
  pickupActivationConditions   String   @default("{}")
  deliveryActivationConditions String   @default("{}")
  pickupDays                   String   @default("[]")
  deliveryDays                 String   @default("[]")
  pickupTimeSlots              String   @default("[]")
  deliveryTimeSlots            String   @default("[]")
  pickupPreparationDays        Int      @default(0)
  deliveryPreparationDays      Int      @default(0)
  pickupOrderLimitPerDay       Int?
  deliveryOrderLimitPerDay     Int?
  pickupOrderLimitPerSlot      Int?
  deliveryOrderLimitPerSlot    Int?
  pickupMaxDaysInAdvance       Int      @default(30)
  deliveryMaxDaysInAdvance     Int      @default(30)
  pickupBlackoutDates          String   @default("[]")
  deliveryBlackoutDates        String   @default("[]")
  pickupTags                   String   @default("")
  deliveryTags                 String   @default("")
  notificationEmails           String   @default("")
  notificationPhones           String   @default("")
  allowedProducts              String   @default("all")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  pickupNextWeekOnly           Boolean  @default(false)
  pickupNextWeekSameWeekDays   String   @default("[]")
  deliveryNextWeekOnly         Boolean  @default(false)
  deliveryNextWeekSameWeekDays String   @default("[]")
  pickupTimeSlotsPerDay        String?  @default("{}")
  deliveryTimeSlotsPerDay      String?  @default("{}")
  rates                        Rate[]
}

model Rate {
  id         String   @id @default(uuid())
  locationId String
  name       String
  type       String
  method     String   @default("BOTH")
  min        Float
  max        Float?
  price      Float
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Settings {
  id                           String  @id @default(uuid())
  shop                         String  @unique
  enablePickup                 Boolean @default(true)
  enableDelivery               Boolean @default(false)
  pickupTitle                  String  @default("Store Pickup")
  deliveryTitle                String  @default("Local Delivery")
  primaryColor                 String  @default("#008060")
  logoUrl                      String  @default("")
  pickupActivationConditions   String  @default("{}")
  deliveryActivationConditions String  @default("{}")
  autoTagPickup                String  @default("")
  autoTagDelivery              String  @default("")
  enableSecurityCode           Boolean @default(true)
  postalCodeValidation         String  @default("none")
  enablePickupNote             Boolean @default(false)
  enableDeliveryNote           Boolean @default(false)
  preselectLocation            String  @default("")
  locationSortOrder            String  @default("newest")
  fallbackRate                 Float   @default(0)
  deliveryTimeSlots            String  @default("9:00 AM - 12:00 PM,12:00 PM - 3:00 PM,3:00 PM - 6:00 PM,5:00 PM - 11:00 PM")
  enablePickupNextWeekOnly     Boolean @default(false)
  pickupNextWeekSameWeekDays   String  @default("[]")
  enableDeliveryNextWeekOnly   Boolean @default(false)
  deliveryNextWeekSameWeekDays String  @default("[]")
}
